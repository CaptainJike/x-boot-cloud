#!/usr/bin/env bash

# Copy this file to scripts/learning-os/env.local before running local scripts.

export NACOS_BASE_URL="http://127.0.0.1:8848"
export NACOS_NAMESPACE=""
export NACOS_GROUP="DEFAULT_GROUP"
export NACOS_USERNAME="nacos"
export NACOS_PASSWORD="nacos"
# Optional: if your Nacos instance already gives you an access token, set it here.
export NACOS_ACCESS_TOKEN=""

export LEARNING_DB_HOST="127.0.0.1"
export LEARNING_DB_PORT="3306"
export LEARNING_DB_NAME="x_boot_learning_os"
export LEARNING_DB_USERNAME="root"
export LEARNING_DB_PASSWORD="root"

export LEARNING_REDIS_HOST="127.0.0.1"
export LEARNING_REDIS_PORT="6379"
export LEARNING_REDIS_PASSWORD=""
export LEARNING_REDIS_DATABASE="13"

export LEARNING_GITHUB_CLIENT_ID=""
export LEARNING_GITHUB_CLIENT_SECRET=""
export LEARNING_GITHUB_REDIRECT_URI="http://localhost:5173/auth/callback"

export LEARNING_MODEL_BASE_URL="http://127.0.0.1:11434"
export LEARNING_MODEL_NAME="llama3.2"
